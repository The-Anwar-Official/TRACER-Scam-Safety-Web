// Optional future persistence layer. The current demo intentionally does not store messages.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalysisEvent {
  id        String   @id @default(cuid())
  level     String
  score     Int
  createdAt DateTime @default(now())

  // Deliberately no message/body field: do not persist users' potentially sensitive messages.
  @@index([createdAt])
  @@index([level, createdAt])
}
